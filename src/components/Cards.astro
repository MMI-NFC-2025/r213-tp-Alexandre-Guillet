---
const { offre } = Astro.props;
import PbImage from './PbImage.astro';
---

<div class="card bg-violet-400 text-white py-12 px-8 text-center mt-auto">
    <PbImage record={offre} recordImage={offre.image[0]}  />

    <h2>{offre.nom_maison}</h2>
    <ul>
        <li>Nom : {offre.nom_maison}</li>
    </ul>
        <a href={`/offres/${offre.id}`}>Voir plus</a>

    {offre.favori && <span class="favori bg-blend-color-burn text-yellow-400">★ Favori</span>}
</div>

<style>
    .card {
        border: 1px solid #ddd;
        padding: 1rem;
        border-radius: 8px;
        max-width: 260px;
    }
    .favori {
        color: rgb(174, 0, 255);
        font-weight: bold;
    }
</style>