---
import { byPrice } from '../../../js/backend.mjs';
import Layout from '../../../layouts/Layout.astro';

const { prix } = Astro.params;
const offres = await byPrice(prix);
---

<Layout titre={`Maisons de moins de ${prix} €`}>
    {offres.map((offre) => (
        <div key={offre.id}>
            <h2>{offre.nom_maison}</h2>
            <ul>
                <li>{offre.adresse}</li>
                <li>{offre.prix} €</li>
                <li>{offre.superficie} m²</li> 
            </ul>
        </div>
    ))}
</Layout>