---
import '../../styles/global.css';
import Layout from '../../layouts/Layout.astro';
import Cards from '../../components/Cards.astro';
    import { getOffres,byPriceMinMax } from '../../js/backend.mjs';
    let offres = await getOffres();
    let message = '';
if (Astro.request.method === "POST") {
    const data = await Astro.request.formData();
    const prixmin = parseInt(data.get("prixmin"));
    const prixmax = parseInt(data.get("prixmax"));

    if (prixmin > 0 && prixmax > 0 && prixmax > prixmin) {
        offres = await byPriceMinMax(prixmin, prixmax);
        if (offres.length === 0) {
            message = `Pas d'offres entre ${prixmin}€ et ${prixmax}€`;
        } else {
            message = `Liste des offres entre ${prixmin}€ et ${prixmax}€`;
        }
    } else {
        message = "Veuillez entrer des valeurs valides pour le prix.";
    }
} else {
    offres = await getOffres();
}
---
<Layout titre="Les offres">
  <h1>Nos offres</h1>
    <form action="/offres" method="POST">
        <input type="number" name="prixmin" placeholder="Prix minimum" />
        <input type="number" name="prixmax" placeholder="Prix maximum" />
        <input type="submit" value="Filtrer par prix" />
    </form>
  <div>
    {
      offres.map((offre) => (
         <div class="offre" data-favori={offre.favori}>
            <!-- Contenu de l'offre -->
            <Cards offre={offre} />
        </div>

      ))
    }

<button id="favori-button" class="bg-slate-600 rounded-lg text-white p-2">Afficher les favoris</button>
<a class="bg-slate-600 rounded-lg text-white p-2" href="/offres/surface/80">Maison de plus de 80 m²</a>
<a class="bg-slate-600 rounded-lg text-white p-2" href="/offres/prix/250000">Maison de moins de 250 000 €</a>
<a class="bg-slate-600 rounded-lg text-white p-2" href="/offres/prixminmax/100000350000">Maisons entre 1 000 € et 350 000 €</a>

<script>
    //@ts-nocheck
    const button = document.getElementById('favori-button');
    let showOnlyFavorites = false;

    button?.addEventListener('click', () => {
        showOnlyFavorites = !showOnlyFavorites;
        const offres = document.querySelectorAll('.offre');

        offres.forEach(offre => {
            const isFavori = offre.dataset.favori === 'true';
            console.log(isFavori);
            if (showOnlyFavorites) {
                offre.style.display = isFavori ? 'block' : 'none';
                button.textContent = 'Afficher tout';
            } else {
                offre.style.display = 'block';
                button.textContent = 'Afficher les favoris';
            }
        });
    });
</script>
</div>
</Layout>